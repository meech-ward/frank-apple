10 HOME:N=0
20 PRINT "BUTTON COUNTER"
30 VTAB 3:HTAB 1:PRINT "COUNT: ";N;"          "
40 VTAB 6:PRINT "UP/DOWN: CHANGE COUNT"
50 PRINT "A: QUIT   B: ZERO   C: ADD TEN"
60 GET K$:K=ASC(K$)
70 IF K=11 THEN N=N+1
80 IF K=10 THEN N=N-1
90 IF K=13 THEN N=0
100 IF K=21 THEN N=N+10
110 IF K=27 THEN HOME:END
120 GOTO 30
