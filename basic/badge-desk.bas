10 REM BADGE DESK - BUTTON APPS FOR TUFTY
20 T=0:S=6
100 TEXT:HOME:NORMAL
110 PRINT "          B A D G E   D E S K"
120 PRINT "---------------------------------------"
130 PRINT:PRINT "A / RETURN     TALLY COUNTER"
140 PRINT:PRINT "B / ESCAPE     DICE ROLLER"
150 PRINT:PRINT "C / SPACE      WIFI DEMO"
160 PRINT:PRINT "HOME BUTTON: DISK MENU"
170 PRINT:PRINT "CTRL-C: BASIC PROMPT"
180 GOSUB 900
190 IF K=13 THEN 300
200 IF K=27 THEN 500
210 IF K=32 THEN 700
220 GOTO 180
300 HOME:PRINT "TALLY COUNTER":PRINT
310 PRINT "COUNT: ";T
320 PRINT:PRINT "A +1    C -1    UP +10    DOWN -10"
330 PRINT:PRINT "B: BACK (KEEPS COUNT THIS SESSION)"
340 GOSUB 900
350 IF K=27 THEN 100
360 IF K=13 THEN T=T+1:GOTO 300
370 IF K=32 THEN T=T-1:GOTO 300
380 IF K=11 THEN T=T+10:GOTO 300
390 IF K=10 THEN T=T-10:GOTO 300
400 GOTO 340
500 HOME:PRINT "DICE ROLLER":PRINT
510 PRINT "SIDES: ";S
520 PRINT:PRINT "A: ROLL   C: SWITCH D6 / D20"
530 PRINT:PRINT "B: BACK"
540 GOSUB 900
550 IF K=27 THEN 100
560 IF K=32 THEN S=26-S:GOTO 500
570 IF K<>13 THEN 540
580 D=INT(RND(1)*S)+1
590 VTAB 10:HTAB 1:PRINT "ROLLED: ";D;"    "
600 GOTO 540
700 HOME:PRINT "WIFI DEMO":PRINT
710 PRINT "A: REFRESH   B: BACK":PRINT
720 IF PEEK(49296)=0 THEN PRINT "WIFI OFFLINE - CHECK WIFI.INI":GOTO 850
730 PRINT "FETCHING...":POKE 49296,1
740 IF PEEK(49152)>127 THEN GET K$:IF ASC(K$)=27 THEN 100
750 E=PEEK(49297):IF E<2 THEN 740
760 IF E<>2 THEN PRINT "FETCH FAILED. A: TRY AGAIN":GOTO 850
770 N=PEEK(49299)+256*PEEK(49300)
780 HOME:PRINT "WIFI DEMO":PRINT
790 IF N=0 THEN PRINT "(EMPTY)":GOTO 840
800 FOR I=1 TO N
810 C=PEEK(49298)
820 IF I<481 AND (C=13 OR C=10 OR C>31 AND C<127) THEN PRINT CHR$(C);
830 NEXT I
840 PRINT:PRINT:PRINT "A: REFRESH   B: BACK"
850 GOSUB 900
860 IF K=27 THEN 100
870 IF K=13 THEN 700
880 GOTO 850
900 R=RND(1)
910 IF PEEK(49152)<128 THEN 900
920 GET K$:K=ASC(K$):RETURN
