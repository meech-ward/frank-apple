10 HOME:PRINT "TRIP COST"
20 INPUT "DISTANCE (KM)? ";K
30 INPUT "LITRES PER 100 KM? ";L
40 INPUT "PRICE PER LITRE? ";P
50 INPUT "PEOPLE SHARING? ";N
60 IF K<0 OR L<0 OR P<0 OR N<1 THEN PRINT "USE POSITIVE VALUES":GOTO 20
70 C=K*L*P/100
80 PRINT "FUEL COST: ";INT(C*100+.5)/100
90 PRINT "COST EACH: ";INT(C/N*100+.5)/100
