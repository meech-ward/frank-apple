10 HOME
20 C=100:H=0:D=1:L=8:T=300
30 DIM N$(3):N$(1)="SOL":N$(2)="VEGA":N$(3)="RIGEL"
40 S=1:X=RND(1)
50 GOSUB 400
60 HOME:PRINT "STAR TRADER - YOUR EIGHT-DAY VOYAGE"
70 PRINT "DAY ";D;"/";L;"   PORT: ";N$(S)
80 PRINT "CREDITS: ";C;"   CARGO: ";H;"/20"
90 PRINT "ORE PRICE: ";P;"   FARE: 10"
100 PRINT:PRINT "1 BUY   2 SELL   3 TRAVEL   4 RETIRE"
110 INPUT "YOUR ORDER? ";A
120 IF A=1 THEN GOSUB 200:GOTO 60
130 IF A=2 THEN GOSUB 300:GOTO 60
140 IF A=3 THEN GOTO 500
150 IF A=4 THEN GOTO 700
160 GOTO 60
200 INPUT "UNITS TO BUY (0 CANCEL)? ";Q
210 IF Q<0 OR Q<>INT(Q) THEN PRINT "WHOLE UNITS ONLY":GOTO 200
220 IF H+Q>20 THEN PRINT "YOUR HOLD IS FULL":GOTO 200
230 IF Q*P>C THEN PRINT "NOT ENOUGH CREDITS":GOTO 200
240 C=C-Q*P:H=H+Q:RETURN
300 INPUT "UNITS TO SELL (0 CANCEL)? ";Q
310 IF Q<0 OR Q<>INT(Q) THEN PRINT "WHOLE UNITS ONLY":GOTO 300
320 IF Q>H THEN PRINT "YOU DO NOT HAVE THAT MANY":GOTO 300
330 C=C+Q*P:H=H-Q:RETURN
400 P=4+S*3+INT(RND(1)*9):RETURN
500 IF C<10 THEN PRINT "NEED 10 CREDITS FOR FARE":GOTO 650
510 PRINT "1 SOL  2 VEGA  3 RIGEL"
520 INPUT "DESTINATION (0 CANCEL)? ";B
530 IF B=0 THEN GOTO 60
540 IF B<1 OR B>3 OR B<>INT(B) OR B=S THEN GOTO 520
550 C=C-10:S=B:D=D+1:GOSUB 400
560 IF RND(1)>.25 THEN GOTO 620
570 E=5+INT(RND(1)*11)
580 IF E>C THEN E=C
590 C=C-E:PRINT "METEOR DAMAGE. REPAIRS COST ";E
620 IF D>L THEN GOTO 700
650 PRINT "PRESS ANY KEY":GET K$:GOTO 60
700 HOME:V=C+H*P
710 PRINT "VOYAGE COMPLETE":PRINT
720 PRINT "CASH: ";C:PRINT "CARGO VALUE: ";H*P
730 PRINT "TOTAL: ";V:PRINT "TARGET: ";T
740 IF V>=T THEN PRINT "YOU EARNED YOUR CAPTAIN'S LICENSE!"
750 IF V<T THEN PRINT "TRY A DIFFERENT TRADING ROUTE."
760 PRINT:PRINT "RUN TO PLAY AGAIN. LIST TO SEE HOW."
