10 TEXT:HOME
20 U$="https://httpbin.org/uuid"
30 PRINT "GET ";U$
40 GOSUB 9000
50 IF E THEN PRINT E$:END
60 PRINT "HTTP ";H
70 GOSUB 9100
80 IF N=0 THEN PRINT:END
90 PRINT B$;:GOTO 70
9000 REM HTTP GET U$ - H=STATUS E=ERROR
9010 E=0:E$="":H=0:ZW=0
9020 IF PEEK(49302)<>1 THEN E=12:GOTO 9200
9030 POKE 49302,0
9040 FOR ZI=1 TO LEN(U$)
9050 POKE 49303,ASC(MID$(U$,ZI,1)):NEXT ZI
9060 POKE 49302,1
9070 IF PEEK(49297)=1 THEN 9070
9080 E=PEEK(49306)
9090 H=PEEK(49304)+256*PEEK(49305):GOTO 9200
9100 REM NEXT TEXT CHUNK - B$ AND N
9110 B$="":N=PEEK(49299)+256*PEEK(49300)
9120 IF N=0 THEN RETURN
9130 IF N>240 THEN N=240
9140 FOR ZI=1 TO N:ZC=PEEK(49303)
9150 IF ZC=10 AND ZW=1 THEN ZW=0:GOTO 9180
9160 ZW=(ZC=13):IF ZC=10 THEN ZC=13
9170 B$=B$+CHR$(ZC)
9180 NEXT ZI:RETURN
9200 IF E=0 THEN RETURN
9210 E$="NETWORK ERROR "+STR$(E)
9220 IF E=1 THEN E$="WIFI IS NOT CONNECTED"
9230 IF E=2 THEN E$="INVALID HTTP OR HTTPS URL"
9240 IF E=3 THEN E$="HOSTNAME NOT FOUND"
9250 IF E=4 THEN E$="CONNECTION FAILED"
9260 IF E=5 THEN E$="REQUEST TIMED OUT"
9270 IF E=6 THEN E$="INCOMPLETE OR INVALID HTTP"
9280 IF E=7 THEN E$="REQUEST OR RESPONSE TOO LARGE"
9290 IF E=8 THEN E$="TOO MANY REDIRECTS"
9300 IF E=9 THEN E$="REQUEST CANCELLED"
9310 IF E=10 THEN E$="TLS OR CERTIFICATE ERROR"
9320 IF E=11 THEN E$="URL TOO LONG"
9330 IF E=12 THEN E$="UNSUPPORTED FORMAT OR FIRMWARE"
9340 IF E=14 THEN E$="INVALID METHOD, HEADERS OR BODY"
9360 RETURN
